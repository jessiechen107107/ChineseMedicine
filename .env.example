# Copy this file to .env and fill in your own keys.
# Never commit .env — it is listed in .gitignore.

# OpenAI API key for TCM analysis features
# Get a key from: https://platform.openai.com/api-keys
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Optional: Weather API key for enhanced weather data
# Get a free key from: https://openweathermap.org/api
EXPO_PUBLIC_WEATHER_API_KEY=your_openweathermap_api_key_here

# Security note: EXPO_PUBLIC_* variables are embedded in the app bundle at build time.
# For production releases, use a backend proxy so API keys stay on the server.
