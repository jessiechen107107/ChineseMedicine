# Copy this file to .env and fill in your own keys.
# Never commit .env — it is listed in .gitignore.

# Claude API key for the AI analysis features (optional: the app falls back to on-device analysis)
# Create a key at: https://platform.claude.com/settings/keys
EXPO_PUBLIC_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OpenWeatherMap key. Without it the app uses Open-Meteo, which needs no key.
# Get a free key from: https://openweathermap.org/api
EXPO_PUBLIC_WEATHER_API_KEY=your_openweathermap_api_key_here

# Security note: EXPO_PUBLIC_* variables are embedded in the app bundle at build time.
# For production releases, use a backend proxy so API keys stay on the server.
